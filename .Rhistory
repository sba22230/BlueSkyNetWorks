ggraph(g2, layout = "manual", x = x, y = y) +
geom_edge_parallel0(aes(width = repost_count, colour = like_count), edge_alpha = 1, arrow = arrow(angle = 30, length = unit(0.15,
"inches"), ends = "last", type = "closed")) +
scale_edge_colour_gradient(low = "#87CEFF", high = "#27408B") +
scale_edge_width(range = c(0.3, 1.2)) +
geom_node_point(aes(fill = posts_authored,
size = reposts_received), colour = "#000000", shape = 21, stroke = 0.3) +
scale_fill_gradient(low = "#87CEFF", high = "#27408B") +
scale_size(range = c(3,
8)) +
theme_graph() +
theme(legend.position = "top") <- graph_from_data_frame(d = edges, vertices = nodes, directed = TRUE)
