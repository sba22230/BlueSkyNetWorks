posts <- bs_get_post_thread('at://did:plc:znrkwcuzdbhduyqrbdpkl7pe/app.bsky.feed.post/3m54urlsan22g', 5, clean = FALSE)
# Extract root post and replies
root <- posts$thread$post
replies <- posts$thread$replies
reply_texts <- map_chr(replies, function(x) {
if (!is.null(x$post$record$text) && length(x$post$record$text) > 0) {
x$post$record$text
} else {
NA_character_
}
})
reply_authors <- map_chr(replies, ~ .x$post$author$handle)
reply_df <- tibble(author = reply_authors, text = reply_texts)
# 4. Safely extract authors and reply targets
reply_authors <- map_chr(replies, function(x) {
if (!is.null(x$post$author$handle)) x$post$author$handle else NA_character_
})
reply_targets <- rep(root$author$handle, length(reply_authors))  # all replies target root
# 5. Build edge list (who replied to whom)
edges <- tibble(from = reply_authors, to = reply_targets)
# 6. Build node list
nodes <- tibble(name = unique(c(edges$from, edges$to)))
g <- graph_from_data_frame(d = edges, vertices = nodes, directed = TRUE)
ggraph(g, layout = "fr") +
geom_edge_link(alpha = 0.3) +
geom_node_point(size = 5) +
geom_node_text(aes(label = name), repel = TRUE)
