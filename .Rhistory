betweenness = as.numeric(btw),
component = as.integer(comps),
stringsAsFactors = FALSE
)
View(node_metrics)
# Persist node_metrics to SQL Server
node_metrics_out <- RxSqlServerData(table = node_metrics_table, connectionString = connStrLocal)
