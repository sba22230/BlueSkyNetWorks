      <data key="e_reply_count">1</data>
      <data key="e_bookmark_count">0</data>
      <data key="e_repost_count">7</data>
      <data key="e_text">I am an Irish citizen from the north and I hold an Irish passport. I can&apos;t vote in the Irish presidential election. I hope yis get Connolly in. Maith an bhean í. #speirgorm</data>
