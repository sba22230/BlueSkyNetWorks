      <data key="e_edgeStarts">2025-06-20</data>
      <data key="e_edgeEnds">2025-06-20</data>
    </edge>
    <edge source="n23" target="n108">
      <data key="e_repost_uri">at://did:plc:eweyharmeuf3er35ejhbjp4o/app.bsky.feed.post/3mbbxdteed22j</data>
      <data key="e_created_at">2025-12-31</data>
      <data key="e_like_count">20</data>
      <data key="e_reply_count">1</data>
      <data key="e_bookmark_count">0</data>
      <data key="e_repost_count">10</data>
      <data key="e_text">How was landlord TD Robert Troy appointed Minister of State for Finance in 2025?
