    <edge source="n238" target="n271">
      <data key="e_repost_uri">at://did:plc:qa4r5kjqwd54f6tzn3sdrbgc/app.bsky.feed.post/3m2my4bhdy224</data>
      <data key="e_created_at">2025-10-07</data>
